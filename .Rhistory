library(tidyverse)
library(readxl)
library(tidyr)
library(rnaturalearth)
library(rnaturalearthdata)
library(sf)
library(mapdata)
rm(list = ls())
setwd("D:\\R\\LBP+NP")
df <- read.csv("map 1.csv", header = TRUE)
load("./data/GBD.Rdata")
colnames(df)
# ---------- 筛选数据 ----------
dfx <- df %>%
filter(measure_name == "Incidence") %>%
filter(sex_name == "Female") %>%
# filter(age_id == 24) %>%   # 如需特定年龄段可取消注释
filter(metric_name == "Rate") %>%
filter(cause_name == "Low back pain")
print(dim(dfx))
# ---------- 合并数据 ----------
dfplot <- dfx %>%
filter(location_id %in% namex$location_id) %>%
select(location_id, val) %>%
left_join(., namex, by = "location_id")
# ---------- 颜色方案 ----------
color1 <- c("#67001f", "#b2182b", "#d6604d", "#f4a582", "#fddbc7",
"#f7f7f7", "#d1e5f0", "#92c5de", "#4393c3", "#2166ac")
# 对于发病率，通常期望低值（低发病率）为蓝色，高值（高发病率）为红色
# color1 原本是从红到蓝（低→高），所以需要反转
color_final <- rev(color1)
# ---------- 构建绘图数据 ----------
ASR <- dfplot %>%
select(location_id, location, val) %>%
mutate(val = val / 1)
df_asr <- left_join(df_world, ASR, by = "location_id")
# ---------- 计算分位数断点（10个区间） ----------
breaks <- quantile(ASR$val, probs = seq(0, 1, length.out = 11), na.rm = TRUE)
breaks <- unique(breaks)  # 去重，防止重复断点
# 生成区间标签（整数，因为发病率通常为整数或保留整数显示）
breaks_int <- round(breaks, 0)
labels <- paste0(
breaks_int[-length(breaks_int)],
" - ",
breaks_int[-1]
)
# ---------- 添加分组变量 ----------
df_asr <- df_asr %>%
mutate(asr_cut = cut(val,
breaks = breaks,
labels = labels,
include.lowest = TRUE))   # 包含最小值
# ---------- 调试：查看英国的值和分组 ----------
uk_check <- df_asr %>% filter(location == "United Kingdom")
print("英国的发病率和分组：")
print(uk_check %>% select(location, val, asr_cut))
# ---------- 绘图 ----------
p <- ggplot(df_asr %>% filter(!is.na(asr_cut))) +
geom_sf(aes(geometry = geometry, fill = asr_cut), size = 0.1) +
scale_fill_manual(
values = color_final,
guide = guide_legend(reverse = FALSE)   # 图例顺序与颜色一致（低→高）
) +
guides(
fill = guide_legend(
label.position = "bottom",
nrow = 1,
title.position = "top",
title = "Age-standardized incidence rate of low back pain per 100,000 population, 2023"
)
)
# ---------- 主题调整 ----------
p1 <- p +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank(),
legend.position = 'top',
legend.background = element_blank(),
legend.key = element_blank(),
legend.key.size = unit(0.6, "cm"),
legend.spacing.x = unit(0.1, "cm"),
legend.spacing.y = unit(0.05, "cm"),
legend.margin = margin(0, 0, 0, 0),
legend.box.margin = margin(-5, 0, -5, 0),
legend.title = element_text(size = 9, face = "bold"),
legend.text = element_text(size = 8, face = "bold"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.border = element_blank(),
panel.background = element_blank()
)
# 显示图形
print(p1)
